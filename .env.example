# =============================================================================
# Paperless Qdrant Search - Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment
# =============================================================================

# -----------------------------------------------------------------------------
# Paperless-ngx Configuration
# -----------------------------------------------------------------------------
# URL to your Paperless-ngx instance
PAPERLESS_URL=http://localhost:8000

# API token from Paperless-ngx (Settings > API Tokens)
PAPERLESS_API_KEY=your_paperless_api_token_here


# -----------------------------------------------------------------------------
# Qdrant Configuration
# -----------------------------------------------------------------------------
# Qdrant collection name for documents
QDRANT_COLLECTION=documents


# -----------------------------------------------------------------------------
# Provider Configuration
# -----------------------------------------------------------------------------
# AI Provider: "ollama" (local) or "google" (cloud API)
# Switch between local Ollama and Google Gemini API
# NOTE: Switching providers requires deleting ./data/qdrant/* and re-indexing
#       because vector dimensions differ (Ollama models vary, Google: 3072)
# Google AI is faster and slightly better, but free tier may use data for training
# Ollama is fully private and local
PROVIDER=ollama


# -----------------------------------------------------------------------------
# Ollama Configuration (Local LLM/Embeddings) - Only if PROVIDER=ollama
# -----------------------------------------------------------------------------
# URL to your Ollama instance (must be running on host)
# Use host.docker.internal when running Ollama on host and app in Docker
OLLAMA_URL=http://host.docker.internal:11434

# Embedding model for vector search
# Best model: qwen3-embedding:8b (excellent multilingual support)
# Alternative: nomic-embed-text (smaller, faster)
# Run: ollama pull qwen3-embedding:8b
EMBEDDING_MODEL=qwen3-embedding:8b

# Reranking model for relevance scoring
# Best model: ministral-3:latest (much better than llama3.2 or qwen3:4b)
# Run: ollama pull ministral-3:latest
RERANK_MODEL=ministral-3:latest

# LLM model for query expansion
# Best model: ministral-3:latest (much better than llama3.2 or qwen3:4b)
# Run: ollama pull ministral-3:latest
LLM_MODEL=ministral-3:latest


# -----------------------------------------------------------------------------
# Google AI Configuration - Only if PROVIDER=google
# -----------------------------------------------------------------------------
# Google AI API Key (get from https://ai.google.dev/)
# Required when PROVIDER=google
# ⚠️ WARNING: Free tier may use your data for training!
#    For private documents, use paid tier or stick with Ollama
GOOGLE_API_KEY=your_google_api_key_here

# Embedding model for Google (gemini-embedding-001 produces 3072-dim vectors)
# Default: gemini-embedding-001 (stable, $0.15/1M tokens)
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# LLM model for query expansion and reranking
# Default: gemini-3-flash-preview (latest Gemini 3, preview)
# Alternative: gemini-2.0-flash-exp
GOOGLE_LLM_MODEL=gemini-3-flash-preview


# -----------------------------------------------------------------------------
# Indexing Configuration
# -----------------------------------------------------------------------------
# How often to poll Paperless for new/updated documents (in minutes)
POLL_INTERVAL_MINUTES=5

# Only index documents with a "reviewed" custom field set to true
# Set to 'false' to index all documents
REQUIRE_REVIEWED=true

# Text chunking configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50


# -----------------------------------------------------------------------------
# Search Configuration
# -----------------------------------------------------------------------------
# Default language for queries (helps LLM understand context)
# Examples: "English", "German", "Spanish", "French", etc.
DEFAULT_QUERY_LANGUAGE=English

# Enable LLM-based query expansion and understanding
# When enabled, natural language queries like "tax documents from last year"
# are expanded and converted to structured filters
ENABLE_QUERY_EXPANSION=true

# Enable cross-encoder reranking for better relevance
# Significantly improves search quality but adds latency
ENABLE_RERANKING=true

# Number of initial results to retrieve from Qdrant
RETRIEVAL_TOP_K=50

# Number of final results to return after reranking
RERANK_TOP_K=10

# Hybrid search balance (0.0 = full keyword, 1.0 = full semantic)
# 0.5 = balanced, 0.8 = more semantic (recommended for better results)
HYBRID_ALPHA=0.8

# Reranking influence on final score (0.0 = no effect, 1.0 = full effect)
# With 0.2, reranking can adjust scores by ±0.2 max
# Example: score=0.7, rerank=8/10 -> final=0.7+0.12=0.82
RERANK_INFLUENCE=0.2

# Max tokens for different reranking operations
# Adjust these for thinking models (like Gemini) that need more tokens
# Dedicated reranker (yes/no response): default 10
RERANK_DEDICATED_MAX_TOKENS=10
# LLM scoring (0-10 relevance score): default 500 (increased for thinking models)
RERANK_LLM_MAX_TOKENS=500
# Explain score (detailed explanation): default 1500
RERANK_EXPLAIN_MAX_TOKENS=1500

# Maximum parallel workers for reranking (default: 20)
# Higher = faster reranking but may hit API rate limits
# Google free tier: ~15 RPM, set to 5-10
# Google paid tier: 1000+ RPM, can use 20-50
RERANK_MAX_WORKERS=20


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
